/* Helper Components */

// Industry Badge component for showing icons based on partner type
function IndustryBadges({ industry, type }: { industry: string, type: string }) {
  const getBadges = (industry: string, type: string) => {
    if (industry === 'Financial Services' && type === 'Bank') {
      return [
        { code: 'FS', color: 'bg-blue-200 text-blue-800' }
      ];
    } else if (industry === 'Insurance' && type === 'Broker') {
      return [
        { code: 'IB', color: 'bg-indigo-200 text-indigo-800' }
      ];
    } else if (industry === 'Technology' && type === 'SaaS') {
      return [
        { code: 'TS', color: 'bg-purple-200 text-purple-800' }
      ];
    } else {
      return [
        { code: 'GP', color: 'bg-gray-200 text-gray-800' }
      ];
    }
  };
  
  const badges = getBadges(industry, type);
  
  return (
    <div className="flex space-x-2">
      {badges.map((badge, index) => (
        <div key={index} className={`${badge.color} w-8 h-8 rounded-lg flex items-center justify-center text-xs font-medium`}>
          {badge.code}
        </div>
      ))}
    </div>
  );
}

// Define interface for saved lists
interface SavedList {
  id: string;
  name: string;
  description: string;
  type: 'selection'; // Lists are only static/selection based now, not dynamic
  filters: {
    searchText?: string;
    status?: string;
    industry?: string;
    type?: string;
    size?: string;
  };
  members: number[]; // IDs of partner members
  isShared: boolean;
  sharedWith?: string[];
  createdBy: string;
  createdAt: Date;
}

// Define interface for views (saved filters)
interface SavedView {
  id: string;
  name: string;
  description: string;
  filters: {
    searchText: string;
    status: string;
    industry: string;
    type: string;
  };
  isShared: boolean;
  createdBy: string;
  createdAt: Date;
}

